[Unit]
Description=NVIDIA Broadcast effects as a virtual mic and camera
Requires=pipewire.service
After=pipewire.service
# WirePlumber must see frames on the loopback camera, or apps won't list it.
Before=wireplumber.service

[Service]
Type=notify
ExecStart=/usr/bin/broadcast-linux run
ExecReload=/bin/kill -HUP $MAINPID
# Workers read these from the user manager; unsetting makes any start act like boot.
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
