post_install() {
    cat <<'MSG'
==> broadcast-linux: finish the setup as your user:
      broadcast-linux setup        # downloads NVIDIA Broadcast for your GPU (EULA prompt)
      systemctl --user enable --now broadcast-linux
==> The virtual camera needs the v4l2loopback module (loaded at boot from
    /usr/lib/modules-load.d/broadcast-linux.conf) and your user in the video group:
      sudo usermod -aG video "$USER"    # then log in again
==> Example config: /usr/share/doc/broadcast-linux/config.toml
    (copy to ~/.config/broadcast-linux/config.toml)
MSG
}

post_upgrade() {
    echo "==> broadcast-linux: run 'systemctl --user restart broadcast-linux' to use the new version"
}
